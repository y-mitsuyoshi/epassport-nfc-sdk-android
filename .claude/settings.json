{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./gradlew :sdk:compileReleaseKotlin :sdk:testDebugUnitTest :sdk:lint",
            "statusMessage": "Verifying code quality (compile, test, lint) before executing commands..."
          }
        ]
      }
    ]
  }
}
