#!/bin/bash
#
# Pre-Commit Hook
# Warns when source files are committed without corresponding unit tests.
# This hook does NOT block the commit; it only prints a warning.
#

YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Get staged Kotlin files in src/main directories
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep 'src/main/.*\.kt$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

MISSING_TESTS=""
MISSING_COUNT=0
while IFS= read -r file; do
    [ -z "$file" ] && continue

    # Convert src/main/path/Foo.kt -> src/test/path/FooTest.kt
    TEST_FILE=$(echo "$file" | sed 's|/main/|/test/|' | sed 's|\.kt$|Test.kt|')

    if [ ! -f "$TEST_FILE" ]; then
        MISSING_TESTS="${MISSING_TESTS}  ${file}  ->  Missing: ${TEST_FILE}\n"
        MISSING_COUNT=$((MISSING_COUNT + 1))
    fi
done <<< "$STAGED_FILES"

if [ "$MISSING_COUNT" -gt 0 ]; then
    echo ""
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}  ⚠️  WARNING: $MISSING_COUNT source file(s) lack unit tests.${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%b' "$MISSING_TESTS"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}  Please add unit tests for the files above before pushing.${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
fi

exit 0
