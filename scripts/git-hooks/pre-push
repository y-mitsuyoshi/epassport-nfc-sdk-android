#!/bin/bash
#
# Pre-Push Quality Verification Hook
# Ensures build, unit tests, and lint pass before allowing a push.
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

MODULES=(":sdk-nfc" ":sdk-ocr" ":app")

# --- Step 0: JAVA_HOME Verification ---
if [ -z "$JAVA_HOME" ]; then
    if ! command -v java >/dev/null 2>&1; then
        FALLBACK_JAVA="/home/yuma/.antigravity-server/extensions/redhat.java-1.54.0-linux-x64/jre/21.0.10-linux-x86_64"
        if [ -d "$FALLBACK_JAVA" ]; then
            echo -e "${YELLOW}ℹ️ JAVA_HOME is not set. Using fallback: $FALLBACK_JAVA${NC}"
            export JAVA_HOME="$FALLBACK_JAVA"
            export PATH="$JAVA_HOME/bin:$PATH"
        fi
    fi
fi

echo ""
echo "=========================================="
echo " Running Pre-Push Quality Verification"
echo "=========================================="

# --- Step 1: Compile ---
echo ""
echo -e "${YELLOW}Step 1/3: Kotlin Compilation...${NC}"
COMPILE_TASKS=""
for mod in "${MODULES[@]}"; do
    COMPILE_TASKS="$COMPILE_TASKS ${mod}:compileReleaseKotlin"
done
./gradlew $COMPILE_TASKS

# --- Step 2: Unit Tests ---
echo ""
echo -e "${YELLOW}Step 2/3: Unit Tests...${NC}"
TEST_TASKS=""
for mod in "${MODULES[@]}"; do
    TEST_TASKS="$TEST_TASKS ${mod}:testDebugUnitTest"
done
./gradlew $TEST_TASKS

# --- Step 3: Lint ---
echo ""
echo -e "${YELLOW}Step 3/3: Lint Checks...${NC}"
LINT_TASKS=""
for mod in "${MODULES[@]}"; do
    LINT_TASKS="$LINT_TASKS ${mod}:lint"
done
./gradlew $LINT_TASKS

# --- Success ---
echo ""
echo -e "${GREEN}==========================================${NC}"
echo -e "${GREEN} All checks passed! Proceeding with push.${NC}"
echo -e "${GREEN}==========================================${NC}"
echo ""
exit 0
